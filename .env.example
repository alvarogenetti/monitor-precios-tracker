# --- Telegram (opcional). Si quedan vacíos, las alertas sólo se loguean y se guardan en la DB.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Servidor web
HOST=127.0.0.1
PORT=8000

# --- Scheduler interno (sólo para `python -m app.main`)
SCHEDULER_ENABLED=false
SCAN_INTERVAL_MINUTES=180

# --- Scraping
HEADLESS=true
# Bloquear hojas de estilo además de imágenes/fuentes/media (más rápido; desactivalo si alguna tienda falla)
BLOCK_STYLESHEETS=true
SCAN_DELAY_MIN=2
SCAN_DELAY_MAX=5
SCRAPE_RETRIES=3
PAGE_TIMEOUT_MS=45000

# --- Rutas (relativas a la raíz del proyecto)
DB_PATH=data/prices.db
TARGETS_PATH=config/targets.json
