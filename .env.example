# --- Telegram (opcional). Si quedan vacíos, las alertas sólo se loguean y se guardan en la base.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mercado Libre: sin uso desde el 23/11/2026 (acceso bloqueado por ML; ver README sección 7).

# --- Alertas (la inflación para valuar cuotas está en config/discovery.json -> finance)
# false (recomendado) = sólo ofertas reales (>= 15 % / >= 30 % debajo del precio de mercado)
ALERT_PRICE_DROPS=false
ALERT_MIN_DROP_PCT=1
# no avisar nada de precios mayores a ALERT_MAX_OVER_HIGH x (precio "caro" o de mercado)
ALERT_MAX_OVER_HIGH=1.5

# --- Servidor web local (python -m app.main / iniciar.ps1)
HOST=127.0.0.1
PORT=8000
SCHEDULER_ENABLED=false
SCAN_INTERVAL_MINUTES=180

# --- Scraping
HEADLESS=true
BLOCK_STYLESHEETS=true
SCAN_DELAY_MIN=2
SCAN_DELAY_MAX=5
SCRAPE_RETRIES=3
PAGE_TIMEOUT_MS=45000

# --- Rutas (relativas a la raíz del proyecto)
DB_PATH=data/prices.db
TARGETS_PATH=config/targets.json
DISCOVERY_PATH=config/discovery.json
SPECS_PATH=config/specs.json
OVERRIDES_PATH=config/overrides.json
